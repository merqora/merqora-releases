# Supabase Configuration
VINZAY_AI_SUPABASE_URL=https://your-project.supabase.co
VINZAY_AI_SUPABASE_KEY=your-service-role-key
VINZAY_AI_SUPABASE_SERVICE_KEY=your-service-role-key
VINZAY_AI_SUPABASE_ANON_KEY=your-anon-key
VINZAY_AI_CONFIDENCE_THRESHOLD=70
VINZAY_AI_DEBUG=false

# Groq LLM API
VINZAY_AI_GROQ_KEY=gsk_your-groq-api-key

# Fallback for supabase_service.py
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
