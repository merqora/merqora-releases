<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme para Android 12+ (API 31+) con SplashScreen API nativo -->
    <style name="Theme.Mercora" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        
        <!-- SplashScreen API Android 12+ - fondo negro, sin icono: la animación real es MercoraSplashScreen -->
        <item name="android:windowSplashScreenBackground">#000000</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#000000</item>
        
        <!-- Optimizaciones de renderizado Android 12+ -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>
    
    <style name="Theme.Mercora.Splash" parent="Theme.Mercora">
        <item name="android:windowBackground">#000000</item>
    </style>
</resources>
