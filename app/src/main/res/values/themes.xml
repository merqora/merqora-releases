<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme principal con SplashScreen API optimizado para Android 12+ -->
    <style name="Theme.Mercora" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Fondo negro: el preview window del cold start debe ser igual al splash Compose -->
        <item name="android:windowBackground">#000000</item>
        
        <!-- Optimizaciones de renderizado (SplashScreen API en values-v31) -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
    
    <!-- Tema espec�fico para Splash sin contenido (m�xima velocidad) -->
    <style name="Theme.Mercora.Splash" parent="Theme.Mercora">
        <item name="android:windowBackground">#000000</item>
    </style>
</resources>
